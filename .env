# AWS Configuration
AWS_REGION=eu-north-1
DYNAMODB_TABLE_NAME=CSV_Summaries  
SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:266735842488:CSVSummaryTopic

# API Configuration
# Don't store actual API keys in this file
# Set these values via environment variables or AWS secrets manager
GROQ_API_KEY=
OPENAI_API_KEY=

# Summary options
# Set to 'True' to use AI for summary generation by default
USE_AI_BY_DEFAULT=False
# Set to 'groq' or 'openai' to choose provider (default: groq)
AI_PROVIDER=groq